# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (never commit the real URI)
MONGO_URI=mongodb://localhost:27017/multivendor_ecommerce

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend (this backend serves all three frontends)
CLIENT_URL=http://localhost:5173
USER_FRONTEND_URL=http://localhost:5173
SELLER_FRONTEND_URL=http://localhost:5174
ADMIN_FRONTEND_URL=http://localhost:5175

# Cloudinary (optional — enables product/KYC uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (optional — enables online payments; checkout falls back to COD)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=